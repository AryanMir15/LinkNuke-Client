{
  "buildCommand": "npm run build && cd ../ && npm run build && rm -rf astro/dist/app && mkdir -p astro/dist/app && cp dist/index.html astro/dist/app/ && cp -r dist/assets astro/dist/app/",
  "outputDirectory": "dist",
  "installCommand": "npm install && cd ../ && npm install",
  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|png|gif|ico|svg|webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://linknuke-backend.fly.dev/api/$1"
    },
    {
      "source": "/app/(.*)",
      "destination": "/app/index.html"
    }
  ]
}
