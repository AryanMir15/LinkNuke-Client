---
import MainLayout from '../../layouts/MainLayout.astro';
import ReactApp from '../../react-app/ReactApp.jsx';

export async function getStaticPaths() {
  return [
    { params: { slug: undefined } }, // For /dashboard
    { params: { slug: "" } },      // For /dashboard/login, /dashboard/register, etc.
  ];
}
---

<MainLayout title="Dashboard - LinkNuke" description="Manage your self-destructing links and files">
